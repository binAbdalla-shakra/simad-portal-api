{
    "installCommand": "npm install --legacy-peer-deps",
    "version": 2,
    "builds": [
        {
            "src": "Admin/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "App/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/v1/admin/(.*)",
            "dest": "Admin/index.js"
        },
        {
            "src": "/api/v1/app/(.*)",
            "dest": "App/index.js"
        }
    ]
}